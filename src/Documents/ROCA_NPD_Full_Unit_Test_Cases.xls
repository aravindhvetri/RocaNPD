<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>ROCA NPD — FULL UNIT TEST CASES</Title>
  <Author>ROCA NPD</Author>
 </DocumentProperties>
 <ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel">
  <WindowHeight>12000</WindowHeight>
  <WindowWidth>24000</WindowWidth>
  <ProtectStructure>False</ProtectStructure>
  <ProtectWindows>False</ProtectWindows>
 </ExcelWorkbook>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="sTitle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="14" ss:Color="#0D5C63" ss:Bold="1"/>
  </Style>
  <Style ss:ID="sNote">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="sHeader">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#0D5C63" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="sData">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="00_Cover">
  <Table ss:ExpandedColumnCount="3" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="240"/>
   <Column ss:Width="360"/>
   <Column ss:Width="80"/>
   <Row ss:Height="24"><Cell ss:StyleID="sTitle" ss:MergeAcross="2"><Data ss:Type="String">ROCA NPD — FULL UNIT TEST CASES</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Master document (Word): ROCA_NPD_Full_Unit_Test_Cases.doc — Sprint 1 + Sprint 2 catalogues + full post–Sprint-2 cases.</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">This workbook: post–Sprint-2 sheets in full (Material Master, SAP Post to SAP, Audit Log Pending).</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Also include Sprint sheets: open Sprint1_Unit_Test_Cases.xls and Sprint2_Unit_Test_Cases.xls, or run python src/Documents/_generate_full_unit_test_cases.py to merge all sheets into one .xls.</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Last updated: 05 October 2026</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Sheets: 10_Admin_Material_Master (9) | 11_SAP_Post_to_SAP (12) | 12_Audit_Log_Pending (6)</Data></Cell></Row>
   <Row><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Delta notes: TC-NAV-005 Material Master is live; TC-MIS-012 Post to SAP uses createZMatMast per line before approve.</Data></Cell></Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="10_Admin_Material_Master">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="100"/><Column ss:Width="220"/><Column ss:Width="80"/><Column ss:Width="70"/><Column ss:Width="220"/><Column ss:Width="260"/><Column ss:Width="260"/><Column ss:Width="140"/><Column ss:Width="200"/>
   <Row ss:Height="24"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin Material Master nav item</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User in Admins SharePoint group</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app as Admin. 2. Open Administration → Material Master.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Route #/admin/material-master loads. Existing / New tabs visible. DataTable matches All Requests styling.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MaterialMaster.tsx, Config.Routes.AdminMaterialMaster</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Existing tab shows ItemType=Old only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD_MaterialMaster has Old and New rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Material Master. 2. Select Existing tab.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only ItemType=Old rows shown. Columns with no values across Old rows are hidden.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed ItemType data</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">filterMaterialMasterByTab, getVisibleMaterialMasterColumns</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New tab shows ItemType=New with all columns</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New rows exist in NPD_MaterialMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Select New tab.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only ItemType=New rows. All catalog columns shown including Code columns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New ItemType rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MaterialMasterItemTypes.New</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Paged fetch beyond list view threshold</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Master list has more than 25 items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Material Master. 2. Observe network/list load.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Service uses SPReadItemsPaged. UI paginates at 50 rows/page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">&gt;50 rows preferred</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SPServices.SPReadItemsPaged</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Global search across visible columns</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Known Material Code / Description on screen</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Type partial Material Code in Search here.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Matching rows remain; non-matches filtered out (case/space insensitive).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Partial code</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">searchTextUtils, MaterialMasterToolbar</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Creation Date From / To filters</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rows with varied Created dates</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Set From and To dates. 2. Apply.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only rows within the date range remain.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Date range covering subset</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MaterialMasterToolbar</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator filter unique options</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple New rows with Initiator from NPDRequest</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Initiator filter.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unique Initiator options from loaded data only. Selecting one filters rows.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple initiators</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">buildMaterialMasterInitiatorOptions</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export filtered Material Master rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filtered rows on New or Existing tab</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Apply filters. 2. Click Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel downloads with currently filtered rows. Loader shows while exporting.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filtered set</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">exportService</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-MM-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Created Date / Created By / Initiator personas</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New tab with Author and Initiator data</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Created Date, Created By, Initiator columns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Personas render for people fields; dates display correctly.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">renderSharePointUserPersona</Data></Cell></Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="11_SAP_Post_to_SAP">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="100"/><Column ss:Width="220"/><Column ss:Width="80"/><Column ss:Width="70"/><Column ss:Width="220"/><Column ss:Width="260"/><Column ss:Width="260"/><Column ss:Width="140"/><Column ss:Width="200"/>
   <Row ss:Height="24"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Development SAP API URL from Config</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">App running on chandrudemo or rinnpddev site</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Trigger Post to SAP. 2. Inspect network request URL.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">POST goes to Config.SapMaterialMasterApi.DevelopmentUrl (qasqr createZMatMast).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dev site</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">resolveSapMaterialMasterApiUrl</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Production URL blank fails closed</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">App on production rinpd site; ProductionUrl empty</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Attempt Post to SAP.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Clear error that Production SAP API URL is not configured. No approve. No Material Master insert.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Production site URL</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SapMaterialMasterApi.ProductionUrl</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">One API call per Item Details line as array of one object</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request with N Item Details lines, all SAP=false</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. MIS clicks Post to SAP. 2. Count network POSTs and inspect bodies.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Exactly N POSTs. Each body is JSON array with exactly one TY_DATA object.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">N=3 preferred</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">postSapMaterialMasterRow, postItemDetailsToSap</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Type maps Finished Products → FERT</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request Material Type = Finished Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Post to SAP. 2. Inspect request JSON matl_type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">matl_type is FERT (not the UI label).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Finished Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">mapSapMaterialTypeCode</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Type maps Traded Products → HAWA</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request Material Type = Traded Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Post to SAP. 2. Inspect matl_type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">matl_type is HAWA.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Traded Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">mapSapMaterialTypeCode</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup fields send LookupCode not display name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Product Segment display ABC with NPD_Lookup LookupCode 1001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Post to SAP. 2. Inspect comm_group (and other lookup fields).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">comm_group=1001 (code), not ABC. Same for MG2–MG5, Color, UOM, Tax, Class, etc.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup Name=ABC Code=1001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">createSapLookupCodeResolver, sapMaterialMasterPayload</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SAP success sets ItemDetails.SAP=true then Material Master insert</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">API returns status True for a line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Post to SAP for one line. 2. Check NPD_ItemDetails.SAP and NPD_MaterialMaster.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SAP column true for that Id. New Material Master row ItemType=New with NPDRequest lookup. Request Approved only if all lines succeed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">status True response</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">markNpdItemDetailPostedToSap, insertMaterialMasterFromNpdItems</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SAP failure does not approve and does not set SAP=true</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">API returns status False for one of several lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Post to SAP with mixed success/failure.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Failed line SAP stays false; not inserted to Material Master. Successful lines stay SAP=true. Request Status not Approved.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed True/False responses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">postItemDetailsToSap</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Retry posts only SAP=false lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Prior attempt left 40 SAP=true and 10 SAP=false</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Post to SAP again. 2. Count API calls.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only 10 API calls for remaining false lines. True lines not resent. Already-stored Material Master rows not duplicated.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Partial prior success</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">excludeMaterialMasterRowsAlreadyStored</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Master Code columns filled from LookupCode</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Successful SAP line with Product Group (MG2) mapped in NPD_Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Complete Post to SAP. 2. Open Admin Material Master New tab.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Product Group (MG2) = display name; Product Group (MG2) Code = LookupCode. Same for all lookup Code columns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MG2 name + code</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">buildMaterialMasterInsertPayload</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Field lengths follow TY_DATA document</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Long lookup / valuation display values</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect payload lengths for plant, val_class, matl_grp_*, etc.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Values trimmed/fitted per SapMaterialMasterFieldLengths.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Finished Product - 6000</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">sapMaterialMasterFieldConfig</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-SAP-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Loader during MM duplicate validation then progress on Submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator Submit with several Item Details lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Submit Request.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Processing loader during Material Master duplicate check; after pass, line-item progress bar appears. Pending page does not hide progress.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multi-line submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">beginUiProcessing, NpdDraftRework overlay</Data></Cell></Row>
  </Table>
 </Worksheet>
 <Worksheet ss:Name="12_Audit_Log_Pending">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="100"/><Column ss:Width="220"/><Column ss:Width="80"/><Column ss:Width="70"/><Column ss:Width="220"/><Column ss:Width="260"/><Column ss:Width="260"/><Column ss:Width="140"/><Column ss:Width="200"/>
   <Row ss:Height="24"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS Pending placeholder after VH Approve</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH approved; MIS not yet acted; same person may be VH and MIS</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open request as MIS (or dual-role). 2. Review Audit Log.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rows show Initiated, VH Approved, then Pending for MIS Coordinator. Pending not suppressed by VH email match.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dual-role user preferred</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdAuditLogTable hasCommentForPendingStep role match</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Approve appears in Audit Log</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Approve with remarks</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. VH Approve. 2. Open Audit Log.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Vertical Head / Approved / System / Action On datetime / comments present.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Action=Approve</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">addNpdApproverComment, formatAuditAction</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Rework appears in Audit Log</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Rework with mandatory remarks</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. VH Rework. 2. Open Audit Log on Initiator Draft/Rework form.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Vertical Head / Rework row present with comments. Request Status Rework.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Action=Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">applyNpdWorkflowAction, NpdAuditLogTable</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Reject appears in Audit Log</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Reject with mandatory remarks</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. VH Reject. 2. View request Audit Log.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Vertical Head / Rejected row present. Request permanently closed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Action=Reject</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">applyNpdWorkflowAction</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending placeholders only while Pending or Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request fully Approved after MIS Post to SAP</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Approved request Audit Log.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No UI-only Pending placeholder rows. Only persisted ApproverComments.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Status=Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">allowPendingPlaceholders</Data></Cell></Row>
   <Row ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-AUD-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Audit Log chronological order</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiated → VH Approve → MIS Pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Action On column order.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Chronological ascending by Action On then Id. Pending placeholders at bottom.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple comments</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">sortAuditRowsChronologically</Data></Cell></Row>
  </Table>
 </Worksheet>
