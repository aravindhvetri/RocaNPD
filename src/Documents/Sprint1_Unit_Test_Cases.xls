 <Worksheet ss:Name="03_Lookup_Master">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin can open Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin, at least one Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Administration &gt; Lookup.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Grid loads. Toolbar search/import/export/add available.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupMaster</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Add Lookup success</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Active Lookup Type exists</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add. 2. Select Lookup Type. 3. Enter Lookup Name and Lookup Code. 4. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Row created in NPD_Lookup. Name/Code/Type shown.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type=UOM, Name=PC, Code=PC</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">lookupService</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup Type required</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Add dialog open</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Leave Lookup Type empty. 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation. No write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupFormDialog required</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup Name required</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type selected</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Leave name empty. 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation. No write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupFormDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup Code required</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type and name filled</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Leave code empty. 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation. No write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupFormDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate Lookup Name within type blocked</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">PC already exists under UOM</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add another PC under UOM.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate warning. Not created.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Name=PC</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">lookupValidation</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same name allowed under different type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Name exists under Type A</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Create same name under Type B.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Allowed if validation is per type (verify current lookupValidation). If blocked globally, record actual vs expected.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same name, different type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">lookupValidation</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Existing lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Edit name/code. 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Grid updates.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Change description/code</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupMaster</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete Lookup unused</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup not referenced</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Delete. Confirm.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Soft deleted. Removed from grid.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unused lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">softDeleteLookup</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete Lookup blocked when used</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup used by Item Details / other dependency</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete blocked dialog with reason. Record remains.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Used lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DeleteBlockedDialog, dependencyValidationService</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple lookups</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search by name or code.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Matching rows only.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Partial text</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MasterToolbarSearch</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export Lookup Excel</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookups exist</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Valid .xlsx with Lookup Type, Name, Code.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">exportToExcel</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import valid Lookups</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel with type + name + code for existing types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New lookups created.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unique names</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">commitImportLookups</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import validation dialog columns</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">File with duplicates</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation popup columns are the Lookup import columns (not NPD S.NO-only). Duplicates listed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate names</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ImportValidationDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-015</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty Lookup grid message</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filter/search matches none</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search nonsense.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Centered No Records Found, 12px.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ZZZZ</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-016</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup options feed NPD Item Details</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">UOM lookups No and PC active</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. As Initiator open New NPD Request. 2. Open UOM on a line.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Options are Lookup Title values (No, PC), not a LookupName column.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">UOM No/PC</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD11, lookupOptionUtils</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-017</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Inactive/deleted lookup not in NPD dropdown</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Soft-deleted UOM value</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Item Details UOM.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Deleted value is not selectable.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Deleted lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">fetchActiveLookups</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LK-018</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Non-admin cannot open Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open #/admin/lookup.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Blocked.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ProtectedRoute</Data></Cell></Row>
  </Table>
