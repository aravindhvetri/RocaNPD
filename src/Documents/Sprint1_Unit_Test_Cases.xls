<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Title>ROCA NPD — SPRINT 1 UNIT TEST CASES</Title>
  <Author>ROCA NPD</Author>
 </DocumentProperties>
 <ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel">
  <WindowHeight>12000</WindowHeight>
  <WindowWidth>24000</WindowWidth>
  <ProtectStructure>False</ProtectStructure>
  <ProtectWindows>False</ProtectWindows>
 </ExcelWorkbook>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="sTitle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="14" ss:Color="#0D5C63" ss:Bold="1"/>
  </Style>
  <Style ss:ID="sNote">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
  <Style ss:ID="sHeader">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#0D5C63"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="11" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#0D5C63" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="sData">
   <Alignment ss:Vertical="Top" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#D0D7DE"/>
   </Borders>
   <Font ss:FontName="Calibri" ss:Size="10" ss:Color="#000000"/>
  </Style>
 </Styles>
 <Worksheet ss:Name="00_Cover">
  <Table ss:ExpandedColumnCount="3" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="220"/>
   <Column ss:Width="320"/>
   <Column ss:Width="80"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sTitle" ss:MergeAcross="2"><Data ss:Type="String">ROCA NPD — SPRINT 1 UNIT TEST CASES</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Document:     Sprint1_Unit_Test_Cases.txt</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Location:     src/Documents/</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Purpose:      Manual Excel import. Each SHEET section below should become</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">              a separate Excel worksheet.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Application:  ROCA NPD (SPFx)</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Sprint scope: Sprint 1 — implemented NPD + Admin masters + Initiator submit</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">              through Vertical Head email only.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Button label: The form button is &quot;SUBMIT REQUEST&quot; (code). Treat &quot;Send Request&quot;</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">              as the same action.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Last updated: 18 September 2026</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Verified against current source (not a runtime UAT run).</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">HOW TO LOAD INTO EXCEL</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">-------------------------------------------------------------------------------</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">1. Create a workbook with one sheet per SHEET name listed in the Cover sheet.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">2. Copy the column header row, then one row per test case.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">3. Suggested columns for every test sheet:</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">   Test Case ID | Title | Type | Priority | Preconditions | Test Steps |</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">   Expected Result | Test Data | Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">4. Status / Actual Result / Tester / Date can be added in Excel.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">SPRINT 1 IN SCOPE</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">-------------------------------------------------------------------------------</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Login, role resolution, side navigation, unauthorized route</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Admin: Lookup Type, Lookup, Workflow Configuration, Brand Material Extension</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- NPD lists: All Requests, Pending Approval, Approved Requests, Draft / ReWork</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- NPD Form: Initiator create / Save Draft / Submit Request</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Submit email to Vertical Head (Approve / Re-work / Reject buttons)</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Common DataTable empty state, search, export, import, tab lock</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Common controls used by the above screens</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">SPRINT 1 OUT OF SCOPE (do not execute in this pack)</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">-------------------------------------------------------------------------------</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Vertical Head Approve / Rework / Reject on the form (after email)</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- MIS Coordinator actions, Post to SAP</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Material Group module</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Reports</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- SAP / Material Master integration</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">PASS/FAIL NOTE</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">-------------------------------------------------------------------------------</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Expected results are taken from the current code and ProjectStandards</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">(R-NPD*, R-SEC*, R-C*). If a step fails, log the defect against the</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Related Rule / Code column.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Sheet Name                         </Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Module                                      </Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Approx TCs</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">00_Cover                           </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Index                                       </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">01_Roles_And_Navigation            </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Login, roles, nav, route guard              </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">18</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">02_Lookup_Type_Master              </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Administration — Lookup Type                </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">16</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">03_Lookup_Master                   </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Administration — Lookup                     </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">18</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">04_Workflow_Configuration          </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Administration — Workflow Configuration     </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">14</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">05_Brand_Material_Extension        </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Administration — Brand Material Extension   </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">12</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">06_NPD_Form_Initiator_Submit       </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New NPD Request through VH email            </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">32</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">07_Draft_Rework                    </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft / ReWork list                         </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">14</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">08_All_Requests                    </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">All Requests dashboard                      </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">16</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">09_Pending_Approval                </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending Approval list                       </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">12</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">10_Approved_Requests               </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved Requests list                      </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">10</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">11_Common_UI_Import_Export         </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Shared DataTable / import / export / empty  </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">12</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="18"><Cell ss:StyleID="sData"><Data ss:Type="String">12_Tab_Lock                        </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Broadcast Channel two-tab lock              </Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">8</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">END OF DOCUMENT</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Total designed Sprint 1 cases: 18+16+18+14+12+40+14+16+12+10+12+8 = 190</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String"></Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">Tester notes:</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Use a dedicated test Initiator, Vertical Head, MIS Coordinator, and Admin.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Configure NPD_WorkflowConfig as Initiator → Vertical Head → MIS Coordinator before form submit tests.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Confirm Graph/Outlook mail is enabled before TC-FRM-032.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Do not execute Vertical Head approval from the email or form in Sprint 1.</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="16"><Cell ss:StyleID="sNote" ss:MergeAcross="2"><Data ss:Type="String">- Log defects with Test Case ID and Related Rule / Code.</Data></Cell></Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/>
   <FrozenNoSplit/>
   <SplitHorizontal>48</SplitHorizontal>
   <TopRowBottomPane>48</TopRowBottomPane>
   <ActivePane>2</ActivePane>
  </WorksheetOptions>
 </Worksheet>
 <Worksheet ss:Name="01_Roles_And_Navigation">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">App loads for mapped Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User exists in ApproversMaster System=New Product Development, Role=Initiator, with at least one Brand</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open the NPD workbench as that user. 2. Wait for app initialize.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">App shell (header + side nav + content) loads. Home redirects to All Requests. No unauthorized page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator email mapped in ApproversMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">permissionService.getDefaultRoute, initializeApp</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator navigation items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same as TC-NAV-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Review NPD Request section in side nav.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Visible: New NPD Request, All Requests, Pending Approval, Approved Requests, Draft / ReWork. Hidden: Administration (unless also Admin). Material Group New/Draft only if also MG Initiator.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator-only user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-SEC03, NAV_ITEM_ALLOWED_ROLES</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Vertical Head navigation items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User mapped as Vertical Head for NPD, not Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app as VH. 2. Review side nav.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Visible: All Requests, Pending Approval, Approved Requests only. Hidden: New NPD Request, Draft / ReWork, Administration.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH-only user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-SEC03, filterNavigationByRoles</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS Coordinator navigation items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User mapped as MIS Coordinator for NPD</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app as MIS. 2. Review side nav.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Visible: All, Pending, Approved, Reports. Hidden: New NPD Request, Draft / ReWork unless also Initiator.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS-only user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-SEC03</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin navigation items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User in SharePoint group Admins</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app as Admin. 2. Review Administration section.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Visible: Lookup Type, Lookup, Workflow Configuration, Brand Material Extension. Material Master may show as placeholder.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin group member</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NAV_ITEM_ALLOWED_ROLES admin-*</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multi-role union navigation</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same user is Initiator + Vertical Head in ApproversMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app. 2. Review nav.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Union of both roles: New Request + Draft/ReWork (Initiator) AND All/Pending/Approved (both). One role does not hide the other.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dual-role user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-SEC03, R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unmapped user sees unauthorized</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User has no ApproversMaster NPD row and is not Admin</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open app.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">User cannot use NPD screens. Access denied / unauthorized or empty role set with protected routes blocking NPD.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unmapped account</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ProtectedRoute, canAccessRoute</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="72"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Direct URL to New Request as VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH-only user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open #/npd/new directly.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ProtectedRoute blocks. Redirect to unauthorized or default allowed route. Not the new-request form.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH-only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ROUTE_ALLOWED_ROLES NpdNew = Initiator, VH, MIS — NOTE: code currently allows VH onto /npd/new for view/edit of existing requests. For NEW create without id, footer is initiator-edit only if canEditDraft. Verify: VH opening /npd/new with no id does not get Save Draft / SUBMIT REQUEST. | Config.Routes.NpdNew, resolveNpdFooterMode</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Compact vs expanded side nav</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any allowed user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Collapse sidebar. 2. Expand again. 3. Click a nav item.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Compact icons still show allowed items only. Clicking navigates. Selected item uses white background + dark teal text.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-UI, SideNavigationCompact</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Active nav item matches route</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Go to All Requests. 2. Go to Pending. 3. Go to Draft / ReWork.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">The matching nav item is selected each time.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NavRouteSync, SideNavigation</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New NPD Request is primary action</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Locate New NPD Request.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item is styled as primary action (gold selected bar). Click opens #/npd/new.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">navigationConfig isPrimaryAction</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">HashRouter deep link after refresh</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator on All Requests</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Navigate to Pending Approval. 2. Refresh the browser.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same hash route reloads Pending Approval, not a blank page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">HashRouter</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unknown hash redirects to default</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open #/does-not-exist.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Redirects to default home (All Requests).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">AppRoutes path=*</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unauthorized page is reachable</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any authenticated user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open #/unauthorized.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unauthorized page renders. Not a crash.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unauthorized.tsx</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-015</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand scope comes from ApproversMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator mapped to Brand ROCA only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open New NPD Request. 2. Open Brand (MG1).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only ROCA (and other brands mapped to that user as Initiator) appear. Brands for other initiators do not.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator+ROCA</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD03, fetchInitiatorBrandOptions</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-016</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH brand scope for lists</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH mapped to Brand ROCA only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open All Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only requests with Brand ROCA are listed. Other brands hidden.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH+ROCA</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD17, fetchNpdDashboardList</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-017</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS sees all NPD brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS Coordinator, requests exist for multiple brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open All Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Requests for all brands appear. MIS “see all” is a superset, not an override of other roles.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD17</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-NAV-018</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Role resolution uses email match</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ApproversMaster Users person field email equals login email</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Login.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Roles resolve via client-side filter after expand (System, Role, Users email). No crash if OData person filter is unsupported.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Matching email</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD05a, personFieldUtils</Data></Cell></Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <FreezePanes/><FrozenNoSplit/><SplitHorizontal>1</SplitHorizontal><TopRowBottomPane>1</TopRowBottomPane><ActivePane>2</ActivePane>
