 <Worksheet ss:Name="07_Draft_Rework">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator sees own drafts only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Drafts exist for Initiator A and B</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Login as A. Open Draft / ReWork.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only A's Draft and Rework rows.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two initiators</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD10</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH cannot open Draft / ReWork nav</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH-only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Look at nav. 2. Open #/npd/draft-rework.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Nav item hidden. Direct URL blocked.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-SEC03</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search Draft / ReWork</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own drafts</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search by Request ID / Brand / Plant.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Matching rows. Unmatched shows No Requests Found 12px.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search text</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdDraftRework</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Status filter Draft vs In Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Both statuses exist</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Filter Draft. 2. Filter In Rework.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Correct subset. In Rework label not raw Rework if formatted.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft + Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getDraftStatusOptions, FieldLabels.InRework</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Filter one brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only that brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">matchesNpdBrandFilter</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit opens form with from=draft-rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Edit.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">URL mode=edit and from=draft-rework. Form editable. Save Draft / SUBMIT REQUEST visible.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD10, R-NPD19</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View is read-only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click View.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">mode=view. No submit.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No Delete on table</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Actions.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit (if allowed) + View only. No Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Workflow icon hidden for Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Workflow column.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No sitemap icon on Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Workflow icon visible for Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rework row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Workflow.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dialog opens. Initiator row highlighted for rework. No mutation.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Columns fit / headings not clipped</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Desktop width</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. View header row.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request ID, Brand (MG1), Material Type, Plant, Products, Status, Current Approver, Submitted Date, Workflow, Actions all one line. Horizontal scroll allowed if needed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestListTable</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Current Approver dash for draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Current Approver.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Shows "—" (not pending). No persona.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getNpdCurrentApprover</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">After Save Draft land on this list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft from new form</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lands on Draft / ReWork. New row visible.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">finishWithSuccess NpdDraftRework</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-DR-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Heading and toolbar</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Page open</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect layout.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Heading and search/filters consistent with other NPD lists.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdDraftRework.tsx</Data></Cell></Row>
  </Table>
