 <Worksheet ss:Name="12_Tab_Lock">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two tabs claim same request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same user, two browser tabs (not duplicated sessionStorage twin if possible — use two windows)</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Tab 1 Edit request. 2. Tab 2 click Edit/View same id.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Tab 2 shows Editing Restricted. Go to Dashboard -&gt; /npd/all. Reload Page reloads.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD22, npdRequestTabSync</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft notifies other tab</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Tab 1 and Tab 2 on same draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Tab 1 Save Draft. 2. Interact in Tab 2.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Tab 2 popup: request saved as draft in another tab, with time.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">kind draft-saved</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Submit notifies other tab</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Both tabs on same request form</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Tab 1 SUBMIT REQUEST. 2. Interact Tab 2.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Tab 2 popup submitted/updated in another tab.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Valid submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">kind submitted</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">List click blocked when locked</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Tab 1 has form open (claimed)</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Tab 2 on All Requests click View/Edit same id.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dialog before navigation. Does not open a second editor.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same id</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">useNpdRequestTabGuard</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New request (no id) does not claim</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two tabs on blank New NPD Request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Type in both.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No Editing Restricted until a SharePoint id exists.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New form</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">isOpen requires requestId</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Go to Dashboard</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Restriction dialog visible</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Go to Dashboard.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Navigates to All Requests. Dialog closes.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">npdTabDashboardRoute</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Reload Page</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Restriction dialog</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Reload Page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Full page reload.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">window.location.reload</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-TAB-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate tab still distinct lock ids</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Chrome Duplicate Tab previously broke sync</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Duplicate tab after opening a request. 2. Act in original.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Other copy still receives lock (in-memory tab id, BroadcastChannel + localStorage poll).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate tab</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getNpdTabId runtimeTabId</Data></Cell></Row>
