   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Page heading above toolbar</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approver/Initiator with access</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Approved Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Heading "Approved Requests" sits above search/filter row.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD18</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only approved/completed in list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mix of statuses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only Approved (and Completed if mapped as approved) rows. No Draft/Pending/Rework.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">isApprovedNpdStatus</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand scope</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator/VH mapped brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Compare to unmapped brand approved request.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unmapped brand hidden. MIS sees all.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD18 / R-NPD17</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filter works. No Requests Found when empty.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">toolbar</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two approved brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Filter brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Subset.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">filter</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export Excel</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">File NPD_Approved_Requests_Export_DD-MM-YYYY.xlsx (or equivalent buildExportFileName).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD18</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View only — no Edit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Actions.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View only (canEditRow false on approved variant). No Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved dashboard variant</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestDashboard canEditRow</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Workflow icon visible</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Workflow.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">All steps completed as stored. No current pending highlight (unless code still highlights none). Read-only.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Current Approver dash</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read column.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">"—" because not pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getNpdCurrentApprover</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-APR-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Cancel from View returns to Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View from this list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. View. 2. Cancel / Back.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Returns to Approved Requests (from=approved).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">from=approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD19</Data></Cell></Row>
