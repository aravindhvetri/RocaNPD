   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Plant disabled until Material Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand selected, type empty</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Check Plant / Source.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Plant / Source disabled or empty until Material Type is chosen.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD05, NpdGeneralInfoSection</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Finished Products plant from PlantMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Type = Finished Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Plant / Source.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Factory plants, PlantType=Factory, Active=Yes, showing PlantCode from ROCA PlantMaster.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Finished Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD05</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Traded Products plant choices</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Type = Traded Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Plant / Source.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Imported and Domestic only.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Traded Products</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD05, NpdTradedPlantSources</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Changing Material Type clears plant</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Plant already selected</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Change Material Type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Plant / Source clears and reloads options for the new type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Switch FP to Traded</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">npdFormSlice setNpdMaterialType</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft blocked without Brand</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty form</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Single toast: Brand (MG1) is required. No list write. Progress overlay not completing a save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD20, validateNpdGeneralInfo</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft blocked without Material Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Toast: Material Type is required. First message only.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand set</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD20</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft blocked without Plant</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand + type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Toast: Plant / Source is required.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD20</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft success without items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">GI complete, item grid empty/blank line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Header saved to NPD_Request. Status=Draft. Title=Brand (not NPD-YYYY-###). Overlay shows line-item progress then navigates to Draft / ReWork.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand ROCA</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD08</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft progress bar</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">GI complete, several item lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Overlay starts immediately. Caption {n} / {m} Line Items Added. Count holds at total-5 until save finishes (e.g. 150→145) then completes to total and redirects.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">10+ lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD08, startSubmitProgress</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft item batch is one call</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">2 or more persistable lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft. 2. Watch network.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">One $batch mutate for item details (not per-row PATCH). Header is a separate add/update.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">2 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD08, batchMutate</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Save Draft 150 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import or enter 150 persistable lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Save Draft.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Completes without UI freeze. Progress never shows 100% before save returns. Items stored against the request.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">150 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD08</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-015</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft WorkFlowJSON built</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">After Save Draft</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Workflow on the draft? Draft hides Workflow icon. 2. Inspect NPD_Request.WorkFlowJSON.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Array of { Role, UserEmail, Status }. Initiator Status "". Approver statuses "".</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft item</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD09, R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-016</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Add item line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Form open</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click add line / plus on last row.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New empty row. S.No increments.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdItemDetailsSection</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-017</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete item line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Delete a non-last row.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Row removed. Remaining S.No updates on current page.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">2 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">useNpdItemDetailsColumns</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-018</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item Details pagination 7</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">8+ lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add 8 lines.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Paginator appears. Page size 7.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">8 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD11, Config.NpdItemDetailsPageSize</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-019</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Roca Global Code required for Roca/Laufen/Armani</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand = Roca</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Confirm Item Details columns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Roca Global Code column visible and required.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand Roca</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRocaGlobalCodeBrands</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-020</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Roca Global Code hidden for other brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand not Roca/Laufen/Armani</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Select that brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Roca Global Code column not shown.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Other brand</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getVisibleNpdItemDetailFields</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-021</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Code max 18</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Type 19 characters in Material Code.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Input capped at 18.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">19 chars</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">maxLength 18</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-022</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Material Description max 40</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Type 41 characters.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Capped at 40.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">41 chars</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">maxLength 40</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-023</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Required item fields on Submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">GI complete, one incomplete line with material code</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. SUBMIT REQUEST.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">First validation toast only (e.g. Item line 1: Material Description is required). Request not submitted.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Partial line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD20, validateNpdRequestForm</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-024</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Submit blocked with zero item lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">GI complete, no persistable items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. SUBMIT REQUEST.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Toast: Add at least one item line. No Request ID generated.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">validateNpdRequestForm</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-025</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MultiSelect options from Lookup Type titles</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookups exist for Product Group (MG2) etc.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Product Group (MG2).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Options match NPD_Lookup titles for that type. Matching ignores punctuation/parentheses. Empty overlay text 12px "No available options".</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MG2 lookups</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD11, R-NPD12</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-026</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item import template</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD_Templates has TemplateType NPDItemDetails</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Import. 2. Download/use template.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import dialog same as Lookup. Max 200 rows.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Template library</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD13</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-027</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item import validation columns</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">File with invalid UOM</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation popup columns S.NO and Validation Error only (no Material Code column). One toast if errors shown as toast.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Bad UOM</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD13</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-028</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Item import success</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Valid Excel ≤200 rows matching lookups</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rows appear in Item Details. Duplicate handling uses Lookup-style duplicate popup when applicable.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Valid file</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdItemDetailsImport</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-029</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SUBMIT REQUEST success — header</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">GI complete, at least one valid line, NPD workflow configured, VH exists for brand</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click SUBMIT REQUEST.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Status=Pending. Title=NPD-YYYY-### (pad 3). First request of year NPD-2026-001 style. Overlay progress same as draft. Navigates to Pending Approval.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Valid form</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD14</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-030</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SUBMIT REQUEST success — items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Same as TC-FRM-029</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit. 2. Check NPD_ItemDetails.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">All persistable lines saved. RequestGeneralInfoId = request Id. Title on item empty. Single batch write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">2+ lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD14, R-NPD16 Title empty</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-031</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">SUBMIT REQUEST workflow pending VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">After submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Workflow Status from Pending list.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Current pending role is Vertical Head (highlighted). Initiator not highlighted. MIS not highlighted. Current Approver column shows VH name + 24px round persona photo. Status label Pending with VH.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Submitted request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD09, R-NPD15, R-NPD21, renderSharePointUserPersona</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="72"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-032</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Email sent to Vertical Head</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH has valid email; Graph/Outlook send configured</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit request. 2. Open VH mailbox.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Email subject "{RequestId} — Approval Required". Body has NPD Request header, ROCA logo, greeting, request details. Buttons Approve, Re-work, Reject. Links use #/npd/new?id=&amp;action=&amp;from=pending. Only VH emails include those buttons.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH inbox</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD16, sendNpdApprovalNotification, shouldIncludeNpdEmailActions</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-033</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Email failure does not roll back request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Simulate mail failure if possible, or disconnect Graph</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request still Pending in SharePoint even if mail throws. Form still navigates/success path after persist.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mail blocked</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">submitNpdRequest try/catch around send</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-034</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request ID skips deleted records</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Soft-deleted NPD-2026-005 exists; 006 is next live</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit new request.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Next id ignores IsDeleted=true rows.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Deleted 005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD14, generateNextNpdRequestId</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-035</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Cancel from New Request goes to All Requests</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Opened from nav (no from query)</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Cancel / Back.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Returns to All Requests. No save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Nav entry</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD19</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-036</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Cancel from query from=draft-rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Opened Edit from Draft list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Cancel / Back.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Returns to Draft / ReWork.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">from=draft-rework</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD19</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-037</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Submit progress holds 5 before total</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">150 valid lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. SUBMIT REQUEST. Watch overlay.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Counter stops around 145 / 150 while save continues, then jumps to 150 / 150 when persist completes. Bar does not show complete before save returns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">150 lines</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">startSubmitProgress holdAt = total-5</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-038</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Autocomplete off on form fields</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Browser with saved addresses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Focus Brand/text inputs.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No browser autofill suggestions (autoComplete=off).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD19</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-039</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View mode has no Submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator opens View from All Requests</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open View.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Footer has Cancel / Back only (read-only). No Save Draft, no SUBMIT REQUEST, no Approve.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View URL mode=view</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15, footerMode read-only</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-FRM-040</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit draft hydrates plant without clearing</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Saved draft with plant</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Edit from Draft list.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand, Material Type, Plant restored. Plant not wiped by setNpdMaterialType on hydrate.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Draft with plant</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD10</Data></Cell></Row>
  </Table>
