 <Worksheet ss:Name="04_Workflow_Configuration">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin opens Workflow Configuration</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Workflow Configuration.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Grid of request type + steps. Add/Edit/Delete available.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">WorkflowConfigurationMaster</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Create NPD Request workflow</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD roles exist in RoleMaster</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add. 2. Request Type = NPD Request. 3. Add steps Initiator → Vertical Head → MIS Coordinator in order. 4. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">One configuration stored in NPD_WorkflowConfig. Sequence preserved.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD Request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD09, workflowConfigurationUtils</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">At least one step required</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Add dialog</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Choose request type. 2. Remove all steps. 3. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Warning: At least one workflow step is required. No write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">WorkflowConfigFormDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Next role options sequential</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD Request type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Set first step role. 2. Open next step role dropdown.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only allowed next roles from configuration utils (cannot skip sequence incorrectly).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getAvailableNextRoleOptions</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate request type blocked</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD Request config already exists</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add another NPD Request workflow.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation prevents duplicate request type configuration.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NPD Request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">workflowConfigurationValidation</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-WF-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit workflow steps</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Existing NPD config</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Edit. 2. Change a step. 3. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Steps updated. Old step ids handled (update/soft delete as coded).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Change sequence</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">softDeleteWorkflowConfiguration / save</Data></Cell></Row>
