   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator sees own pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own pending + others pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Pending Approval.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own Pending requests shown per list service rules.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two initiators pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15, npdRequestListService</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH sees brand-pending-VH only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending VH ROCA and pending VH other brand; also a pending-MIS request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Login VH ROCA. Open Pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only Pending with VH for mapped brands. No pending-MIS-only rows. No other-brand VH.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MIS sees all pending-MIS</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending MIS across brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Login MIS. Open Pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">All requests whose current pending role is MIS Coordinator.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search and brand filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Several pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search. 2. Filter brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filters apply. Empty message when none.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdDraftRework reused table</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">After Initiator submit, request appears here</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Just submitted</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit. 2. Land on Pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New NPD-YYYY-### visible. Status Pending with VH.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New submit</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">finishWithSuccess NpdPending</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH Edit shows approval footer (out of Sprint 1 execute)</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Informational</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH pending request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Note Edit is visible for acting VH.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Sprint 1: do not click Approve/Reject/Rework. Record that Edit is available for later sprint.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD16 OUT OF SPRINT 1</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View has no approval buttons</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. View as VH or Initiator.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Read-only footer. No Approve/Rework/Reject.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD16</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Workflow column not in Actions</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Confirm separate Workflow column.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Sitemap icon present (not Draft).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export if toolbar has Export</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Export if present.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel OK or control absent — record actual.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">toolbar</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No Delete</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending table</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Actions.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No Delete icon.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD15</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Persona on Current Approver</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Confirm photo + name.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">24px round photo for VH email.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH email</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">personFieldUtils</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-PEN-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Headers and spacing</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Desktop</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Review columns including Actions.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Headings complete. Extra empty gap on Actions reduced. Horizontal scroll acceptable.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestListTable</Data></Cell></Row>
