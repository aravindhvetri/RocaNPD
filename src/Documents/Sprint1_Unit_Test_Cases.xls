   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator All Requests brand scope</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Requests for mapped and unmapped brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open All Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only brands mapped to this Initiator in ApproversMaster.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD17</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Summary cards</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed statuses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. View cards.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Total, Pending, In Rework/Drafts, Approved counts match the scoped list (not global unscoped).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed data</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestSummaryCards</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rows exist</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search Request ID, Plant, Brand, code, material text as placeholder.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Matching rows. Empty: No Requests Found 12px centered slightly up.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request ID</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestListToolbar</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Status filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed statuses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Filter Pending / Approved / Draft / Rework / Rejected.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Correct rows. Pending filter uses stored status Pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">All statuses</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">useNpdRequestListFilters</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Brand filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple brands in scope</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Filter one brand.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Subset. All Brands restores.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two brands</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">filter dropdown</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export Excel</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Filtered or full list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">.xlsx not CSV. Name Export still. Columns include Request ID, Brand, Material Type, Plant, Products, Status, date.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD17, exportToExcel</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Status Pending with VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request pending VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Status column.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">"Pending with VH" (or Pending with Vertical Head label from FieldLabels.PendingWithVh). Tag styling pending.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending VH</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">formatNpdRequestListStatus</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Current Approver name + photo</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending VH with UserEmail</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Current Approver.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Display name plus 24px perfectly round persona from /_layouts/15/userphoto.aspx?size=S&amp;username={email}.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH email</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">renderSharePointUserPersona</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Current Approver dash when not pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved or Draft row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Current Approver.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">"—"</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Approved</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getNpdCurrentApprover</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Products line count</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Request with 2 items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Products.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Badge "2 lines" (or "1 line").</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">2 items</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ProductCount</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Workflow dialog highlight pending role only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending VH request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Workflow.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Dialog lists JSON steps. Only VH pending row light highlight. No italic/colored role text. Close does not change data.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD21</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit vs View</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Own Draft and someone else's Pending</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect Actions.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit only when user can act. View always. No Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Mixed</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">canEditNpdListRow</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">View URL includes from=all</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. View. 2. Cancel.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Returns to All Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">from=all</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD19</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Submitted Date format</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any row</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Read Submitted Date.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DD-MM-YYYY.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Created date</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">formatNpdCreatedDate</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-015</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Header names single line</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Desktop</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect headers.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No wrapped/clipped Products heading. Scroll OK if needed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestList.module.scss</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-ALL-016</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Cards responsive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Narrow window</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Resize below 1100px.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Cards go to 2 columns.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">NpdRequestList.module.scss media</Data></Cell></Row>
