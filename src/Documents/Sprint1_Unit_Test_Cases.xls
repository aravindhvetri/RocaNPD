 </Worksheet>
 <Worksheet ss:Name="02_Lookup_Type_Master">
  <Table ss:ExpandedColumnCount="9" ss:FullColumns="1" ss:FullRows="1">
   <Column ss:Width="95"/><Column ss:Width="210"/><Column ss:Width="90"/><Column ss:Width="70"/><Column ss:Width="230"/><Column ss:Width="250"/><Column ss:Width="250"/><Column ss:Width="150"/><Column ss:Width="190"/>
   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin can open Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin user</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Administration &gt; Lookup Type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Master screen loads with toolbar (search, import, export, add) and DataTable.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupTypeMaster</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Non-admin cannot open Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator-only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open #/admin/lookup-type.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Route blocked. Unauthorized or redirect.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Initiator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ProtectedRoute</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Add Lookup Type success</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin, unique name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Add. 2. Enter Lookup Type name. 3. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Record created in NPD_LookupType. Grid refreshes. Success toast. Soft-delete flag is active (not deleted).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type = Product Group MG2</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">lookupTypeService, softDelete</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Lookup Type name required</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin, add dialog open</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Leave name empty. 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Validation warning. No SharePoint write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupTypeFormDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate Lookup Type blocked</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type "UOM" already exists (active)</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Add another "UOM" (same spelling, different case). 2. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate validation. Record not created.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">uom vs UOM</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">lookupType validation</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Edit Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Existing type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Edit. 2. Change name. 3. Save.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Name updated. Grid shows new name.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rename a test type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LookupTypeMaster</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete Lookup Type with no children</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type not used by any Lookup</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Delete. 2. Confirm.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Soft delete (IsDeleted). Row disappears from active grid.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unused type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">softDeleteLookupType</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete Lookup Type blocked when used</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type has Lookup children</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Delete blocked dialog. Record remains active.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Type used by lookups</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DeleteBlockedDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Search Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Multiple types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Type a partial name in search.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Grid filters to matching rows. Clear search restores all.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Partial name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">MasterToolbarSearch</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty search result message</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Types exist</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search a value that matches nothing.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Centered empty message (No Records Found), 12px, slightly above vertical center.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ZZZZ</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable emptyMessage</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export Lookup Type Excel</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Types exist</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel .xlsx downloads. Filename {Name}_Export_{DD-MM-YYYY}. Header row themed.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">exportToExcel, R-B39j</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import valid Lookup Types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel with new unique types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import. 2. Select file. 3. Confirm.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New types created. Success toast with count.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">New unique names</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">commitImportLookupTypes</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-013</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import duplicate shows validation dialog</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Excel contains an existing type name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import file.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ImportValidationDialog shows S.NO + Validation Error. User can cancel or proceed only with valid new rows per current import rules.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Duplicate name</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ImportValidationDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-014</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import rejects wrong file type / oversize</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Non-xlsx or over max size</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Try import.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">File rejected with size/format message. No write.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">.txt file</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Config.ImportExport</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-015</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pagination on Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">More than one page of types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Change page / page size.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Paginator report: Showing x to y of z entries. No extra box around report.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">20+ types</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable paginator</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-LT-016</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Soft-deleted type not listed</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Previously deleted type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open Lookup Type grid.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Deleted type is not in the active list.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Deleted type title</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">getActiveRecordFilters</Data></Cell></Row>
  </Table>
