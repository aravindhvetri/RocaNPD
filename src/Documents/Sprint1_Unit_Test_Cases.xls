   <Row ss:AutoFitHeight="0" ss:Height="22"><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Case ID</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Title</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Type</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Priority</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Preconditions</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Steps</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Expected Result</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Test Data</Data></Cell><Cell ss:StyleID="sHeader"><Data ss:Type="String">Related Rule / Code</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-001</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable empty message</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any master or NPD list with no rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Force empty (filter).</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Message 12px, horizontally centered, slightly above middle of body.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty filter</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable.module.scss, _primereact-overrides</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-002</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable sort</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Two+ rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Click sortable headers.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Sort toggles. Header stays one line.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any list</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable sortable</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-003</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">DataTable paginator</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">&gt; page size</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Use first/prev/next/last.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Report text left, controls right. Showing x to y of z entries.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">15+ rows</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">_datatable-pagination</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-004</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Loader overlay on list load</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Slow network optional</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Open All Requests.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Loader overlay while status=loading.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">LoaderOverlay</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-005</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Toast first error only</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Form missing multiple fields</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Submit empty GI.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Only first validation message.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Empty GI</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-NPD20, firstValidationMessage</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-006</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Import dialog file constraints</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Negative</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Import oversized or bad extension.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Rejected with Config.ImportExport labels.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Huge file</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ImportDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-007</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Export is Excel not CSV</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">High</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Any export button</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">.xlsx. Button still named Export.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">exportToExcel</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-008</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Confirm delete dialog</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Admin unused lookup type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Confirm dialog before soft delete.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Unused type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">ConfirmDialog</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-009</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Poppins font on overlays</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Open dropdown overlay</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Inspect font.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Poppins on dropdown/dialog/toast.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-UI, theme</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-010</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No PrimeReact import in feature screens</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Informational</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Code review</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Search feature folders for primereact/*.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Feature modules import common/controls only.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">R-C01</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-011</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Master toolbar height consistent</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Low</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Compare Lookup vs Lookup Type</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Compare search/import/export/add.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Shared compact height.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">—</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">_master-toolbar</Data></Cell></Row>
   <Row ss:AutoFitHeight="0" ss:Height="48"><Cell ss:StyleID="sData"><Data ss:Type="String">TC-UI-012</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Persona reusable from CommonServices</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Positive</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Medium</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">Pending request</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">1. Confirm photo on Current Approver. 2. Confirm helper is personFieldUtils.renderSharePointUserPersona.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">No extra feature-only Persona component folder. Email is username query param.</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">VH email</Data></Cell><Cell ss:StyleID="sData"><Data ss:Type="String">personFieldUtils</Data></Cell></Row>
