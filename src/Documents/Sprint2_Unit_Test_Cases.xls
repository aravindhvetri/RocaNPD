    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Mail webpart action processing</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Trigger action in mail webpart. 2. Observe loader display.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Loader is positioned exactly at the center of the viewport (vertical &amp; horizontal). Two concentric circular rings are visible.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Processing state</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdApproverMailLoader.module.scss, .centerContainer</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
