   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-008</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Admin Lookup Type Master auto-fetches on navigation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Lookup type added in background</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to Admin &gt; Lookup Type (/admin/lookup-type).</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">LookupTypeMaster mounts. fetchLookupTypes executes and populates latest lookup types without hard refresh.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Route = /admin/lookup-type</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">LookupTypeMaster.tsx, fetchLookupTypes</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-009</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Brand Material Extension Master auto-fetches on navigation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Brand extension modified</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to Admin &gt; Brand Material Extension.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">BrandMaterialExtensionMaster mounts. fetchBrandMaterialExtensions, fetchRocaBrandOptions, fetchRocaPlantOptions execute.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Route = /admin/brand-extension</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">BrandMaterialExtensionMaster.tsx</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-010</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Workflow Configuration Master auto-fetches on navigation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Workflow steps updated</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to Admin &gt; Workflow Configuration.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">WorkflowConfigurationMaster mounts. fetchWorkflowConfigurations and fetchNpdRoleOptions execute.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Route = /admin/workflow-config</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">WorkflowConfigurationMaster.tsx</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-011</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Material Group New Request auto-fetches configs on navigation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Config updated in NPD_MaterialGroupConfigs</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to /mg/new.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">useMaterialGroupFormController dispatches fetchMaterialGroupConfigsThunk and renders latest category cards.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Route = /mg/new</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">useMaterialGroupFormController</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-012</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Background lookup fetch does not show blocking full-page loader</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">User navigating to /npd/new with existing cached lookups</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to /npd/new. 2. Observe UI during background lookup re-fetch.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Full-page LoaderOverlay remains hidden because lookupOptionsByType already has keys. Form is interactive immediately.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Non-blocking</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdRequestForm.tsx loader visible condition</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-013</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Existing form inputs preserved during background option refresh</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">User enters General Info fields while background fetch resolves</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Type in Project Name. 2. Wait for lookup thunk to fulfill.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Project Name text is not reset or erased. Form input state remains intact.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">State preservation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">npdFormSlice</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-REF-014</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Soft-deleted lookup omitted after navigation</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Lookup marked IsDeleted='Yes' in Admin screen</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to /npd/new. 2. Open corresponding Item Details MultiSelect.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Soft-deleted value is excluded from options list automatically after navigation.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Soft delete</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">lookupService.fetchActiveLookups</Data></Cell>
   </Row>
  </Table>
