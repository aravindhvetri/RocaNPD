   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MIS-021</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Multi-role user acting as MIS Coordinator</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">User is both Initiator and MIS Coordinator</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open request pending at MIS Coordinator step.</Data></Cell>
