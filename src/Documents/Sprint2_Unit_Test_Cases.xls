   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-001</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NPDApproverMail webpart loads with URL parameters</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">URL contains valid requestId, action=Approve, token, approverEmail</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to mail webpart URL in browser.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Webpart initializes and parses query parameters without throwing errors.</Data></Cell>
