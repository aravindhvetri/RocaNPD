   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MIS-022</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdAuditLogTable displays complete approval chain</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Request with Initiator submit, VH approve, and MIS approve</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open request and inspect NPD Audit Log.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Shows sequential entries: Initiator (Submit), Vertical Head (Approved, ActionVia=System), MIS Coordinator (Approved, ActionVia=System).</Data></Cell>
