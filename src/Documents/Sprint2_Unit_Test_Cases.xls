   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MG-001</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Material Group New Request form mounts</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">User has Material Group Initiator role</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Navigate to /mg/new.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Form mounts with Category Selection cards and dynamic entry tables. Title displays 'New Material Group Request'.</Data></Cell>
