   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-014</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Mail action Reject records ActionVia = Mail and remarks</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">User submits Reject with remarks via mail webpart</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Enter 'Budget rejected'. 2. Submit.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Request Status becomes Rejected. Row added to NPD_ApproversComments with ActionVia='Mail', Action='Rejected', Comments.</Data></Cell>
