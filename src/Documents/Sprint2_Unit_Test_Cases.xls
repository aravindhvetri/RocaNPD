   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-015</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Re-clicking already approved link blocks duplicate action</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Request already approved in previous step</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open the same Approve link again in browser.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">System detects step is no longer pending for this approver. Displays 'Already Submitted' banner at top. No duplicate records written.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Duplicate click</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">validateMailActionEligibility</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-016</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Invalid token rejected</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">URL token modified or corrupted</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open mail link with altered token.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Webpart displays error banner at top: 'Invalid or expired approval token.' Action is not executed.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Invalid token</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">validateMailToken</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-017</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Mismatched approver email rejected</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Negative</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Logged-in user email differs from email in token/link</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open mail link intended for user A while logged in as user B.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Action rejected with unauthorized message at top: 'You are not authorized to perform this action.'</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Unauthorized email</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">validateMailApproverIdentity</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-018</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Mail action updates visible in main application immediately</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Action completed via mail webpart</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Log in to main NPD app as Initiator or MIS. 2. Open request.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Header status, workflow status dialog, and audit log table immediately reflect the action completed via mail.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Real-time sync</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">npdWorkflowStatusView</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-019</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdAuditLogTable displays Action Via = Mail for mail action</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Request approved via mail webpart</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. Open request in main application. 2. View NPD Audit Log table.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Action Via column displays 'Mail' (not 'System'). Action On displays formatted date and time.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Action Via = Mail</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdAuditLogTable.tsx</Data></Cell>
   </Row>
   <Row ss:AutoFitHeight="0" ss:Height="48">
    <Cell ss:StyleID="s67"><Data ss:Type="String">TC-MAL-020</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Multiple approvers acting via mail sequentially</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Positive</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">High</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Request submitted; VH approves via mail; MIS approves via mail</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">1. VH clicks Approve in Outlook. 2. MIS clicks Approve in Outlook.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">Both steps complete successfully. Audit log shows two rows with ActionVia='Mail'. Request becomes Approved.</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">End-to-end mail flow</Data></Cell>
    <Cell ss:StyleID="s67"><Data ss:Type="String">NpdApproverMail, npdWorkflowJsonService</Data></Cell>
