  <tr><td><code>slices/npdFormSlice.ts</code> + <code>npdFormState.types.ts</code></td><td>Active NPD form state (generalInfo, items, otherDetails, options, saveStatus)</td><td>NpdRequestForm + controller</td></tr>
  <tr><td><code>slices/npdRequestSlice.ts</code> + types</td><td>Dashboard list collections</td><td>NpdRequestDashboard, NpdDraftRework</td></tr>
  <tr><td><code>slices/materialGroupSlice.ts</code></td><td>MG form + dashboard state</td><td>MG form + dashboard</td></tr>
  <tr><td><code>slices/materialMasterSlice.ts</code></td><td>MM rows, tab, filters, load status</td><td>MaterialMaster admin</td></tr>
  <tr><td><code>thunks/appThunks.ts</code></td><td>initializeApp → resolveUserAccess</td><td>MainComponent</td></tr>
  <tr><td><code>thunks/lookupThunks.ts</code></td><td>Lookup fetch/CRUD/import/export</td><td>LookupMaster</td></tr>
  <tr><td><code>thunks/lookupTypeThunks.ts</code></td><td>Lookup Type CRUD</td><td>LookupTypeMaster</td></tr>
  <tr><td><code>thunks/workflowConfigurationThunks.ts</code></td><td>Workflow config CRUD</td><td>WorkflowConfigurationMaster</td></tr>
  <tr><td><code>thunks/brandMaterialExtensionThunks.ts</code></td><td>Brand extension CRUD</td><td>BrandMaterialExtensionMaster</td></tr>
  <tr><td><code>thunks/npdFormThunks.ts</code></td><td>Hydrate, options, draft, submit, workflow actions, other details, Post to SAP orchestration</td><td>useNpdRequestFormController</td></tr>
  <tr><td><code>thunks/npdRequestThunks.ts</code></td><td>Fetch All / Pending / Draft-Rework / Approved lists</td><td>NPD list screens</td></tr>
